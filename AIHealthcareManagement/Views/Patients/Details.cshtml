@model AIHealthcareManagement.Models.Patient

@{
    ViewData["Title"] = "Patient Details";
}

<div class="page-header">
    <h1>Patient Profile</h1>
    <p>View complete personal, medical and emergency contact information.</p>
</div>

<!-- Patient Summary -->
<div class="profile-summary">

    <div class="profile-avatar">
        👤
    </div>

    <div>
        <h2>@Model.FullName</h2>
        <p>
            @Model.Gender
            @if (!string.IsNullOrEmpty(Model.BloodGroup))
            {
                <span>• @Model.BloodGroup</span>
            }
        </p>

        <span class="status-badge">
            Patient Profile
        </span>
    </div>

</div>


<!-- Personal Information -->
<div class="section-header mt-4">
    <span class="section-icon">👤</span>
    <div>
        <h2>Personal Information</h2>
        <p>Patient's basic personal and demographic details.</p>
    </div>
</div>

<hr />

<div class="details-grid">

    <div class="detail-card">
        <span>Full Name</span>
        <strong>@Model.FullName</strong>
    </div>

    <div class="detail-card">
        <span>Date of Birth</span>
        <strong>@(Model.DateOfBirth?.ToString("dd MMM yyyy"))</strong>
    </div>

    <div class="detail-card">
        <span>Gender</span>
        <strong>@Model.Gender</strong>
    </div>

    <div class="detail-card">
        <span>Blood Group</span>
        <strong>@Model.BloodGroup</strong>
    </div>

</div>

<div class="detail-card full-width-card">
    <span>Address</span>
    <strong>@Model.Address</strong>
</div>


<!-- Medical Information -->
<div class="section-header mt-4">
    <span class="section-icon">🩺</span>
    <div>
        <h2>Medical Information</h2>
        <p>Patient's known allergies and chronic medical conditions.</p>
    </div>
</div>

<hr />

<div class="details-grid">

    <div class="detail-card">
        <span>Allergies</span>
        <strong>
            @(string.IsNullOrWhiteSpace(Model.Allergies)
                ? "No known allergies"
                : Model.Allergies)
        </strong>
    </div>

    <div class="detail-card">
        <span>Chronic Conditions</span>
        <strong>
            @(string.IsNullOrWhiteSpace(Model.ChronicConditions)
                ? "No chronic conditions"
                : Model.ChronicConditions)
        </strong>
    </div>

</div>


<!-- Emergency Contact -->
<div class="section-header mt-4">
    <span class="section-icon">📞</span>
    <div>
        <h2>Emergency Contact</h2>
        <p>Emergency contact information for the patient.</p>
    </div>
</div>

<hr />

<div class="details-grid">

    <div class="detail-card">
        <span>Contact Name</span>
        <strong>@Model.EmergencyContactName</strong>
    </div>

    <div class="detail-card">
        <span>Contact Phone</span>
        <strong>@Model.EmergencyContactPhone</strong>
    </div>

</div>


<!-- Profile Information -->
<div class="section-header mt-4">
    <span class="section-icon">📋</span>
    <div>
        <h2>Profile Information</h2>
        <p>Additional patient profile details.</p>
    </div>
</div>

<hr />

<div class="details-grid">

    <div class="detail-card">
        <span>Profile Created</span>
        <strong>@Model.CreatedAt.ToString("dd MMM yyyy")</strong>
    </div>

    <div class="detail-card">
        <span>Patient ID</span>
        <strong>#@Model.PatientId</strong>
    </div>

</div>


<!-- Actions -->
<div class="form-actions mt-4">

    <a asp-action="Edit"
       asp-route-id="@Model.PatientId"
       class="btn btn-primary">
        Edit Patient
    </a>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        Back to List
    </a>

</div>