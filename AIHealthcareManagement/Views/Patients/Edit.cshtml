@model AIHealthcareManagement.Models.Patient

@{
    ViewData["Title"] = "Edit Patient";
}

<div class="page-header">
    <h1>Edit Patient</h1>
    <p>Update the patient's personal, medical and emergency contact information.</p>
</div>

<form asp-action="Edit">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="PatientId" />
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="CreatedAt" />

    <!-- Personal Information -->
    <div class="section-header">
        <span class="section-icon">👤</span>
        <div>
            <h2>Personal Information</h2>
            <p>Update the patient's basic personal and demographic details.</p>
        </div>
    </div>

    <hr />

    <div class="form-grid">

        <div class="form-group">
            <label asp-for="FullName"></label>
            <input asp-for="FullName"
                   class="form-control"
                   placeholder="Enter patient's full name" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="DateOfBirth">Date of Birth</label>
            <input asp-for="DateOfBirth"
                   type="date"
                   class="form-control" />
            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Gender"></label>
            <select asp-for="Gender" class="form-control">
                <option value="">Select gender</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Other">Other</option>
            </select>
            <span asp-validation-for="Gender" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="BloodGroup">Blood Group</label>
            <select asp-for="BloodGroup" class="form-control">
                <option value="">Select blood group</option>
                <option value="A+">A+</option>
                <option value="A-">A-</option>
                <option value="B+">B+</option>
                <option value="B-">B-</option>
                <option value="AB+">AB+</option>
                <option value="AB-">AB-</option>
                <option value="O+">O+</option>
                <option value="O-">O-</option>
            </select>
            <span asp-validation-for="BloodGroup" class="text-danger"></span>
        </div>

    </div>

    <div class="form-group">
        <label asp-for="Address"></label>
        <textarea asp-for="Address"
                  class="form-control"
                  rows="3"
                  placeholder="Enter patient's complete address"></textarea>
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>


    <!-- Medical Information -->
    <div class="section-header mt-4">
        <span class="section-icon">🩺</span>
        <div>
            <h2>Medical Information</h2>
            <p>Update allergies and chronic medical conditions.</p>
        </div>
    </div>

    <hr />

    <div class="form-grid">

        <div class="form-group">
            <label asp-for="Allergies"></label>
            <textarea asp-for="Allergies"
                      class="form-control"
                      rows="3"
                      placeholder="Enter known allergies, if any"></textarea>
            <span asp-validation-for="Allergies" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ChronicConditions">Chronic Conditions</label>
            <textarea asp-for="ChronicConditions"
                      class="form-control"
                      rows="3"
                      placeholder="Enter chronic medical conditions, if any"></textarea>
            <span asp-validation-for="ChronicConditions" class="text-danger"></span>
        </div>

    </div>


    <!-- Emergency Contact -->
    <div class="section-header mt-4">
        <span class="section-icon">📞</span>
        <div>
            <h2>Emergency Contact</h2>
            <p>Update the patient's emergency contact details.</p>
        </div>
    </div>

    <hr />

    <div class="form-grid">

        <div class="form-group">
            <label asp-for="EmergencyContactName">Contact Name</label>
            <input asp-for="EmergencyContactName"
                   class="form-control"
                   placeholder="Enter emergency contact name" />
            <span asp-validation-for="EmergencyContactName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="EmergencyContactPhone">Contact Phone</label>
            <input asp-for="EmergencyContactPhone"
                   class="form-control"
                   placeholder="Enter emergency contact phone number" />
            <span asp-validation-for="EmergencyContactPhone" class="text-danger"></span>
        </div>

    </div>


    <div class="form-actions mt-4">
        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Cancel
        </a>
    </div>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}