@model AIHealthcareManagement.Models.Patient

@{
    ViewData["Title"] = "Delete Patient";
}

<div class="patient-page">

    <!-- Page Header -->
    <div class="page-header">
        <h1>Delete Patient</h1>
        <p>Review the patient's information before permanently deleting the profile.</p>
    </div>

    <!-- Warning -->
    <div class="delete-warning">
        <div class="warning-icon">⚠️</div>
        <div>
            <h4>Are you sure you want to delete this patient?</h4>
            <p>
                This action cannot be undone. The patient's profile and related
                information may be permanently removed.
            </p>
        </div>
    </div>

    <!-- Patient Summary -->
    <div class="patient-summary">
        <div class="section-icon">👤</div>

        <div>
            <h2>@Model.FullName</h2>

            <p class="patient-meta">
                @Model.Gender • @Model.BloodGroup
            </p>
        </div>
    </div>

    <!-- Personal Information -->
    <section class="info-section">

        <div class="section-heading">
            <div class="section-icon">👤</div>

            <div>
                <h2>Personal Information</h2>
                <p>Patient's basic personal and demographic details.</p>
            </div>
        </div>

        <div class="section-divider"></div>

        <div class="info-grid">

            <div class="detail-card">
                <span>Full Name</span>
                <strong>@Model.FullName</strong>
            </div>

            <div class="detail-card">
                <span>Date of Birth</span>
                <strong>@Model.DateOfBirth?.ToString("dd MMM yyyy")</strong>
            </div>

            <div class="detail-card">
                <span>Gender</span>
                <strong>@Model.Gender</strong>
            </div>

            <div class="detail-card">
                <span>Blood Group</span>
                <strong>@Model.BloodGroup</strong>
            </div>

            <div class="detail-card full-width">
                <span>Address</span>
                <strong>@Model.Address</strong>
            </div>

        </div>

    </section>

    <!-- Medical Information -->
    <section class="info-section">

        <div class="section-heading">
            <div class="section-icon">🩺</div>

            <div>
                <h2>Medical Information</h2>
                <p>Patient's known allergies and chronic medical conditions.</p>
            </div>
        </div>

        <div class="section-divider"></div>

        <div class="info-grid">

            <div class="detail-card">
                <span>Allergies</span>
                <strong>
                    @(string.IsNullOrWhiteSpace(Model.Allergies)
                        ? "None"
                        : Model.Allergies)
                </strong>
            </div>

            <div class="detail-card">
                <span>Chronic Conditions</span>
                <strong>
                    @(string.IsNullOrWhiteSpace(Model.ChronicConditions)
                        ? "None"
                        : Model.ChronicConditions)
                </strong>
            </div>

        </div>

    </section>

    <!-- Emergency Contact -->
    <section class="info-section">

        <div class="section-heading">
            <div class="section-icon">📞</div>

            <div>
                <h2>Emergency Contact</h2>
                <p>Primary emergency contact information.</p>
            </div>
        </div>

        <div class="section-divider"></div>

        <div class="info-grid">

            <div class="detail-card">
                <span>Contact Name</span>
                <strong>@Model.EmergencyContactName</strong>
            </div>

            <div class="detail-card">
                <span>Phone Number</span>
                <strong>@Model.EmergencyContactPhone</strong>
            </div>

        </div>

    </section>

    <!-- Actions -->
    <div class="form-actions">

        <form asp-action="Delete">
            <input type="hidden" asp-for="PatientId" />

            <a asp-action="Index" class="btn-cancel">
                ← Cancel
            </a>

            <button type="submit" class="btn-delete">
                🗑 Delete Patient
            </button>
        </form>

    </div>

</div>