@model IEnumerable<AIHealthcareManagement.Models.Doctor>

@{
    ViewData["Title"] = "Doctors";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Doctors</h1>
        <p class="text-muted mb-0">
            Manage doctor profiles, specializations and verification details.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        + Add New Doctor
    </a>
</div>

<div class="card p-3">
    <div class="table-responsive">

        <table class="table table-hover align-middle mb-0">

            <thead>
                <tr>
                    <th>Doctor</th>
                    <th>Specialization</th>
                    <th>Qualification</th>
                    <th>License Number</th>
                    <th>Experience</th>
                    <th>Consultation Fee</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            <strong>
                                @item.FullName
                            </strong>
                        </td>

                        <td>
                            @item.Specialization
                        </td>

                        <td>
                            @item.Qualification
                        </td>

                        <td>
                            <span class="text-muted">
                                @item.LicenseNumber
                            </span>
                        </td>

                        <td>
                            @item.YearsOfExperience years
                        </td>

                        <td>
                            ₹@item.ConsultationFee
                        </td>

                        <td>
                            @if (item.IsVerified)
                            {
                                <span class="badge bg-success">
                                    Verified
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    Pending
                                </span>
                            }
                        </td>

                        <td>
                            @item.CreatedAt.ToString("dd MMM yyyy")
                        </td>

                        <td class="text-nowrap">

                            <a asp-action="Edit"
                               asp-route-id="@item.DoctorId"
                               class="btn btn-sm btn-primary">
                                Edit
                            </a>

                            <a asp-action="Details"
                               asp-route-id="@item.DoctorId"
                               class="btn btn-sm btn-secondary">
                                View
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.DoctorId"
                               class="btn btn-sm btn-danger">
                                Delete
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
</div>