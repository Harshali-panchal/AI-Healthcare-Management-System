@model AIHealthcareManagement.Models.MedicalRecord

@{
    ViewData["Title"] = "Delete Medical Record";
}

<div class="page-header">
    <div>
        <h1>Delete Medical Record</h1>
        <p>Review the record details before permanently deleting it.</p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>
        Back to Records
    </a>
</div>

<div class="delete-card">

    <!-- Warning Header -->
    <div class="delete-warning-header">

        <div class="delete-warning-icon">
            <i class="bi bi-exclamation-triangle"></i>
        </div>

        <div>
            <h2>Are you sure you want to delete this record?</h2>

            <p>
                This action cannot be undone. Please review the medical
                record details carefully before continuing.
            </p>
        </div>

    </div>


    <!-- Record Summary -->
    <div class="delete-record-summary">

        <div class="delete-summary-icon">
            <i class="bi bi-file-earmark-medical"></i>
        </div>

        <div>
            <span class="delete-summary-label">Medical Record</span>

            <h3>
                @Model.Diagnosis
            </h3>

            <p>
                Patient:
                <strong>@Model.Patient?.FullName</strong>
            </p>
        </div>

    </div>


    <!-- Details -->
    <div class="delete-details-section">

        <div class="details-section-title">

            <div class="section-icon small-icon">
                <i class="bi bi-clipboard2-pulse"></i>
            </div>

            <div>
                <h3>Record Information</h3>
                <p>Details associated with this medical record.</p>
            </div>

        </div>


        <div class="details-grid">

            <div class="detail-item">
                <span class="detail-label">Diagnosis</span>

                <span class="detail-value">
                    @Model.Diagnosis
                </span>
            </div>


            <div class="detail-item">
                <span class="detail-label">Record Date</span>

                <span class="detail-value">
                    @Model.RecordDate.ToString("dd MMM yyyy")
                </span>
            </div>


            <div class="detail-item">
                <span class="detail-label">Patient</span>

                <span class="detail-value">
                    @Model.Patient?.FullName
                </span>
            </div>


            <div class="detail-item">
                <span class="detail-label">Doctor</span>

                <span class="detail-value">
                    Dr. @Model.Doctor?.FullName
                </span>
            </div>


            <div class="detail-item full-detail">
                <span class="detail-label">Consultation Notes</span>

                <div class="consultation-notes">
                    @Model.ConsultationNotes
                </div>
            </div>

        </div>

    </div>


    <!-- Delete Actions -->
    <form asp-action="Delete" method="post" class="delete-actions">

        <input type="hidden" asp-for="RecordId" />

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-x-lg"></i>
            Cancel

        </a>

        <button type="submit"
                class="btn btn-danger">

            <i class="bi bi-trash"></i>
            Yes, Delete Record

        </button>

    </form>

</div>