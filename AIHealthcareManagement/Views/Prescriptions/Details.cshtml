@model AIHealthcareManagement.Models.Prescription

@{
    ViewData["Title"] = "Prescription Details";
}

<div class="page-header">
    <div>
        <h1>Prescription Details</h1>
        <p>Review the complete medicine and treatment information.</p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>
        Back to Prescriptions
    </a>
</div>


<div class="details-card">

    <!-- Header -->
    <div class="details-card-header">

        <div class="section-icon">
            <i class="bi bi-capsule-pill"></i>
        </div>

        <div>
            <h2>Prescription Information</h2>
            <p>Complete details of the prescribed medicine.</p>
        </div>

    </div>

    <div class="section-divider"></div>


    <!-- Medical Record -->
    <div class="details-section">

        <div class="section-heading">

            <div class="section-icon small-icon">
                <i class="bi bi-file-earmark-medical"></i>
            </div>

            <div>
                <h3>Medical Record</h3>
                <p>Associated medical record information.</p>
            </div>

        </div>

        <div class="details-grid">

            <div class="detail-item">
                <span class="detail-label">Medical Record ID</span>
                <span class="detail-value">
                    @Model.Record?.RecordId
                </span>
            </div>

        </div>

    </div>


    <!-- Medicine Information -->
    <div class="details-section">

        <div class="section-heading">

            <div class="section-icon small-icon">
                <i class="bi bi-capsule"></i>
            </div>

            <div>
                <h3>Medicine Information</h3>
                <p>Medicine dosage and treatment schedule.</p>
            </div>

        </div>


        <div class="details-grid">

            <div class="detail-item">
                <span class="detail-label">Medicine Name</span>
                <span class="detail-value">
                    @Model.MedicineName
                </span>
            </div>


            <div class="detail-item">
                <span class="detail-label">Dosage</span>
                <span class="detail-value">
                    @Model.Dosage
                </span>
            </div>


            <div class="detail-item">
                <span class="detail-label">Frequency</span>
                <span class="detail-value">
                    @Model.Frequency
                </span>
            </div>


            <div class="detail-item">
                <span class="detail-label">Duration</span>
                <span class="detail-value">
                    @Model.DurationDays Days
                </span>
            </div>

        </div>

    </div>


    <!-- Instructions -->
    <div class="details-section">

        <div class="section-heading">

            <div class="section-icon small-icon">
                <i class="bi bi-journal-text"></i>
            </div>

            <div>
                <h3>Patient Instructions</h3>
                <p>Special instructions for taking the prescribed medicine.</p>
            </div>

        </div>


        <div class="instruction-box">
            @Model.Instructions
        </div>

    </div>


    <div class="form-divider"></div>


    <!-- Actions -->
    <div class="details-actions">

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left"></i>
            Back to List

        </a>


        <a asp-action="Edit"
           asp-route-id="@Model.PrescriptionId"
           class="btn btn-primary">

            <i class="bi bi-pencil"></i>
            Edit Prescription

        </a>

    </div>

</div>