@model AIHealthcareManagement.Models.Appointment

@{
    ViewData["Title"] = "Delete Appointment";
}

<div class="page-header">
    <div>
        <h1>Delete Appointment</h1>
        <p>Review the appointment information before permanently deleting it.</p>
    </div>
</div>

<div class="warning-banner">
    <div class="warning-icon">
        <i class="bi bi-exclamation-triangle-fill"></i>
    </div>

    <div>
        <h3>Are you sure you want to delete this appointment?</h3>
        <p>
            This action cannot be undone. The appointment information may be
            permanently removed from the system.
        </p>
    </div>
</div>

<div class="profile-summary">
    <div class="profile-icon">
        <i class="bi bi-calendar-x"></i>
    </div>

    <div>
        <h2>@Model.Patient?.FullName</h2>
        <p>
            Appointment with <strong>Dr. @Model.Doctor?.FullName</strong>
        </p>
    </div>
</div>

<div class="section-title">
    <div class="section-icon">
        <i class="bi bi-calendar-event"></i>
    </div>

    <div>
        <h2>Appointment Information</h2>
        <p>Review all appointment details before confirming deletion.</p>
    </div>
</div>

<div class="info-grid">

    <div class="detail-card">
        <span>Appointment Date</span>
        <strong>@Model.AppointmentDate.ToString("dd MMM yyyy")</strong>
    </div>

    <div class="detail-card">
        <span>Appointment Time</span>
        <strong>@Model.AppointmentTime</strong>
    </div>

    <div class="detail-card">
        <span>Status</span>
        <strong>@Model.Status</strong>
    </div>

    <div class="detail-card">
        <span>Doctor</span>
        <strong>Dr. @Model.Doctor?.FullName</strong>
    </div>

    <div class="detail-card">
        <span>Patient</span>
        <strong>@Model.Patient?.FullName</strong>
    </div>

    <div class="detail-card">
        <span>Reason for Visit</span>
        <strong>@Model.ReasonForVisit</strong>
    </div>

</div>

@if (Model.CreatedAt != null || Model.UpdatedAt != null)
{
    <div class="section-title metadata-title">
        <div class="section-icon">
            <i class="bi bi-clock-history"></i>
        </div>

        <div>
            <h2>Record Information</h2>
            <p>System record timestamps for this appointment.</p>
        </div>
    </div>

    <div class="info-grid">

        @if (Model.CreatedAt != null)
        {
            <div class="detail-card">
                <span>Created At</span>
                <strong>@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</strong>
            </div>
        }

        @if (Model.UpdatedAt != null)
        {
            <div class="detail-card">
                <span>Last Updated</span>
                <strong>@Model.UpdatedAt?.ToString("dd MMM yyyy, hh:mm tt")</strong>
            </div>
        }

    </div>
}

<div class="section-divider"></div>

<div class="form-actions">

    <a asp-action="Index" class="btn-secondary">
        <i class="bi bi-arrow-left"></i>
        Back to Appointments
    </a>

    <form asp-action="Delete">
        <input type="hidden" asp-for="AppointmentId" />

        <button type="submit" class="btn-delete">
            <i class="bi bi-trash"></i>
            Delete Appointment
        </button>
    </form>

</div>