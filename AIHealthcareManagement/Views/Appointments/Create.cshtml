@model AIHealthcareManagement.Models.Appointment

@{
    ViewData["Title"] = "Schedule Appointment";
}

<div class="page-header">
    <div>
        <h1>Schedule Appointment</h1>
        <p>Create a new appointment by selecting the patient, doctor and appointment details.</p>
    </div>
</div>

<div class="form-card">

    <div class="section-heading">
        <i class="bi bi-calendar-plus"></i>
        <div>
            <h3>Appointment Information</h3>
            <p>Enter the required details to schedule a new appointment.</p>
        </div>
    </div>

    <hr />

    <form asp-action="Create">

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger validation-summary">
        </div>

        <div class="form-grid">

            <!-- Patient -->
            <div class="form-group">
                <label asp-for="PatientId">Patient</label>

                <select asp-for="PatientId"
                        class="form-control"
                        asp-items="ViewBag.PatientId">
                    <option value="">-- Select Patient --</option>
                </select>

                <span asp-validation-for="PatientId"
                      class="text-danger">
                </span>
            </div>

            <!-- Doctor -->
            <div class="form-group">
                <label asp-for="DoctorId">Doctor</label>

                <select asp-for="DoctorId"
                        class="form-control"
                        asp-items="ViewBag.DoctorId">
                    <option value="">-- Select Doctor --</option>
                </select>

                <span asp-validation-for="DoctorId"
                      class="text-danger">
                </span>
            </div>

            <!-- Appointment Date -->
            <div class="form-group">
                <label asp-for="AppointmentDate">Appointment Date</label>

                <input asp-for="AppointmentDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="AppointmentDate"
                      class="text-danger">
                </span>
            </div>

            <!-- Appointment Time -->
            <div class="form-group">
                <label asp-for="AppointmentTime">Appointment Time</label>

                <input asp-for="AppointmentTime"
                       type="time"
                       class="form-control" />

                <span asp-validation-for="AppointmentTime"
                      class="text-danger">
                </span>
            </div>

            <!-- Reason -->
            <div class="form-group full-width">
                <label asp-for="ReasonForVisit">Reason for Visit</label>

                <textarea asp-for="ReasonForVisit"
                          class="form-control"
                          rows="4"
                          placeholder="Describe the reason for the appointment..."></textarea>

                <span asp-validation-for="ReasonForVisit"
                      class="text-danger">
                </span>
            </div>

        </div>

        <!-- Actions -->
        <div class="form-actions">

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
                Back to Appointments
            </a>

            <button type="submit"
                    class="btn btn-primary save-btn">
                <i class="bi bi-calendar-check"></i>
                Schedule Appointment
            </button>

        </div>

    </form>

</div>


<style>

    .page-header {
        margin-bottom: 30px;
    }

    .page-header h1 {
        color: #2f5540;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .page-header p {
        color: #6c757d;
        margin-bottom: 0;
    }

    .form-card {
        background: white;
        border: 1px solid #e8ece9;
        border-radius: 14px;
        padding: 30px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        max-width: 1100px;
    }

    .section-heading {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .section-heading i {
        font-size: 28px;
        color: #2f5540;
    }

    .section-heading h3 {
        margin: 0;
        color: #2f5540;
        font-weight: 600;
    }

    .section-heading p {
        margin: 4px 0 0;
        color: #6c757d;
        font-size: 14px;
    }

    .form-card hr {
        margin: 25px 0;
        border-color: #e9ecef;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
    }

    .full-width {
        grid-column: span 2;
    }

    .form-group {
        margin-bottom: 0;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #43564a;
    }

    .form-control {
        width: 100%;
        min-height: 46px;
        border-radius: 9px;
        border: 1px solid #d8ded9;
        padding: 10px 13px;
        transition: 0.2s ease;
    }

    .form-control:focus {
        border-color: #4f765f;
        box-shadow: 0 0 0 3px rgba(79, 118, 95, 0.12);
    }

    textarea.form-control {
        resize: vertical;
        min-height: 110px;
    }

    .validation-summary:empty {
        display: none;
    }

    .form-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 30px;
        padding-top: 25px;
        border-top: 1px solid #e9ecef;
    }

    .form-actions .btn {
        padding: 10px 18px;
        border-radius: 8px;
    }

    .save-btn {
        background: #2f5540;
        border-color: #2f5540;
    }

    .save-btn:hover {
        background: #244331;
        border-color: #244331;
    }

    @@media (max-width: 768px) {

        .form-card {
            padding: 20px;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .full-width {
            grid-column: span 1;
        }

        .form-actions {
            flex-direction: column-reverse;
            align-items: stretch;
            gap: 12px;
        }

        .form-actions .btn {
            width: 100%;
        }

    }

</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}