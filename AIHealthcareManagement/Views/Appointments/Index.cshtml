@model IEnumerable<AIHealthcareManagement.Models.Appointment>

@{
    ViewData["Title"] = "Appointments";
}

<div class="page-header">
    <div>
        <h1>Appointments</h1>
        <p>Manage and track all patient appointments in one place.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary create-btn">
        <i class="bi bi-plus-circle"></i> Schedule Appointment
    </a>
</div>

<div class="content-card">

    <div class="table-header">
        <div>
            <h3>Appointment List</h3>
            <p>View, manage and update scheduled appointments.</p>
        </div>

        <div class="appointment-count">
            @Model.Count() Appointments
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table appointment-table">
                <thead>
                    <tr>
                        <th>Appointment</th>
                        <th>Doctor</th>
                        <th>Patient</th>
                        <th>Status</th>
                        <th>Reason for Visit</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="appointment-date">
                                    <strong>
                                        @item.AppointmentDate.ToString("dd MMM yyyy")
                                    </strong>

                                    <span>
                                        @item.AppointmentTime
                                    </span>
                                </div>
                            </td>

                            <td>
                                <div class="doctor-info">
                                    <i class="bi bi-person-badge"></i>
                                    <span>
                                        @(item.Doctor?.FullName ?? "Not Assigned")
                                    </span>
                                </div>
                            </td>

                            <td>
                                <div class="patient-info">
                                    <i class="bi bi-person"></i>
                                    <span>
                                        @(item.Patient?.FullName ?? "Not Assigned")
                                    </span>
                                </div>
                            </td>

                            <td>
                                @{
                                    var statusClass = item.Status?.ToLower() switch
                                    {
                                        "scheduled" => "status-scheduled",
                                        "completed" => "status-completed",
                                        "cancelled" => "status-cancelled",
                                        _ => "status-default"
                                    };
                                }

                                <span class="status-badge @statusClass">
                                    @item.Status
                                </span>
                            </td>

                            <td>
                                <div class="reason-text">
                                    @(string.IsNullOrEmpty(item.ReasonForVisit)
                                        ? "No reason provided"
                                        : item.ReasonForVisit)
                                </div>
                            </td>

                            <td>
                                <div class="action-buttons">

                                    <a asp-action="Details"
                                       asp-route-id="@item.AppointmentId"
                                       class="action-btn view-btn"
                                       title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.AppointmentId"
                                       class="action-btn edit-btn"
                                       title="Edit Appointment">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.AppointmentId"
                                       class="action-btn delete-btn"
                                       title="Delete Appointment">
                                        <i class="bi bi-trash"></i>
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-calendar-x"></i>
            <h4>No Appointments Found</h4>
            <p>There are currently no appointments scheduled.</p>

            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i>
                Schedule First Appointment
            </a>
        </div>
    }
</div>


<style>

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        flex-wrap: wrap;
        gap: 20px;
    }

        .page-header h1 {
            color: #2f5540;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .page-header p {
            color: #6c757d;
            margin-bottom: 0;
        }

    .create-btn {
        padding: 10px 18px;
        border-radius: 8px;
    }

    .content-card {
        background: white;
        border-radius: 14px;
        padding: 25px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        border: 1px solid #e9ecef;
    }

    .table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        padding-bottom: 20px;
        border-bottom: 1px solid #e9ecef;
    }

        .table-header h3 {
            color: #2f5540;
            margin-bottom: 5px;
            font-weight: 600;
        }

        .table-header p {
            margin: 0;
            color: #6c757d;
            font-size: 14px;
        }

    .appointment-count {
        background: #eef6f0;
        color: #2f5540;
        padding: 8px 14px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 14px;
    }

    .appointment-table {
        margin-bottom: 0;
    }

        .appointment-table thead {
            background: #f8faf9;
        }

        .appointment-table th {
            color: #4b5d52;
            font-weight: 600;
            border-bottom: 1px solid #dee2e6;
            padding: 15px;
            white-space: nowrap;
        }

        .appointment-table td {
            padding: 18px 15px;
            vertical-align: middle;
            border-color: #edf0ee;
        }

        .appointment-table tbody tr {
            transition: 0.2s ease;
        }

            .appointment-table tbody tr:hover {
                background: #fafcfb;
            }

    .appointment-date {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .appointment-date strong {
            color: #344c3e;
            font-size: 14px;
        }

        .appointment-date span {
            color: #6c757d;
            font-size: 13px;
        }

    .doctor-info,
    .patient-info {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .doctor-info i {
            color: #2f5540;
        }

        .patient-info i {
            color: #6c63ff;
        }

    .status-badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-scheduled {
        background: #fff3cd;
        color: #856404;
    }

    .status-completed {
        background: #d1e7dd;
        color: #0f5132;
    }

    .status-cancelled {
        background: #f8d7da;
        color: #842029;
    }

    .status-default {
        background: #e9ecef;
        color: #495057;
    }

    .reason-text {
        max-width: 220px;
        color: #5d6660;
        font-size: 14px;
    }

    .action-buttons {
        display: flex;
        gap: 8px;
    }

    .action-btn {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        text-decoration: none;
        transition: 0.2s ease;
    }

    .view-btn {
        background: #e8f0ff;
        color: #0d6efd;
    }

    .edit-btn {
        background: #fff3cd;
        color: #b8860b;
    }

    .delete-btn {
        background: #fdeaea;
        color: #dc3545;
    }

    .action-btn:hover {
        transform: translateY(-2px);
        opacity: 0.85;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
    }

        .empty-state i {
            font-size: 50px;
            color: #adb5bd;
        }

        .empty-state h4 {
            margin-top: 20px;
            color: #344c3e;
        }

        .empty-state p {
            color: #6c757d;
            margin-bottom: 20px;
        }

    @@media (max-width: 768px) {

        .page-header {
            align-items: flex-start;
        }

        .table-header {
            align-items: flex-start;
            flex-direction: column;
            gap: 15px;
        }

        .content-card {
            padding: 15px;
        }
    }

</style>