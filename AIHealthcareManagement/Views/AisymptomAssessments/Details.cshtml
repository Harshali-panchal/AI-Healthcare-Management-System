@model AIHealthcareManagement.Models.AisymptomAssessment

@{
    ViewData["Title"] = "Assessment Details";
}

<div class="page-header">
    <div>
        <h1>AI Assessment Details</h1>
        <p>Review the complete AI-generated symptom assessment.</p>
    </div>
</div>

<div class="content-card">

    <div class="detail-header">
        <div class="detail-title">
            <div class="detail-icon">
                <i class="bi bi-cpu"></i>
            </div>

            <div>
                <h2>Assessment Result</h2>
                <p>
                    AI-powered symptom analysis and healthcare recommendation.
                </p>
            </div>
        </div>

        <span class="urgency-badge @Model.UrgencyLevel?.ToLower()">
            @Model.UrgencyLevel
        </span>
    </div>

    <div class="details-grid">

        <div class="detail-card">
            <span class="detail-label">
                <i class="bi bi-person"></i>
                Patient
            </span>

            <strong>
                @Model.Patient?.FullName
            </strong>
        </div>

        <div class="detail-card">
            <span class="detail-label">
                <i class="bi bi-exclamation-triangle"></i>
                Urgency Level
            </span>

            <strong>
                @Model.UrgencyLevel
            </strong>
        </div>

        <div class="detail-card">
            <span class="detail-label">
                <i class="bi bi-graph-up"></i>
                Confidence Score
            </span>

            <strong>
                @($"{Model.ConfidenceScore * 100:0}%")
            </strong>
        </div>

        <div class="detail-card">
            <span class="detail-label">
                <i class="bi bi-cpu"></i>
                Model Version
            </span>

            <strong>
                @Model.ModelVersion
            </strong>
        </div>

        <div class="detail-card">
            <span class="detail-label">
                <i class="bi bi-calendar-event"></i>
                Created At
            </span>

            <strong>
                @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
            </strong>
        </div>

    </div>


    <div class="assessment-section">

        <div class="section-title">
            <i class="bi bi-clipboard-pulse"></i>
            <h3>Reported Symptoms</h3>
        </div>

        <div class="assessment-content symptoms-content">
            @Model.SymptomsInput
        </div>

    </div>


    <div class="assessment-section">

        <div class="section-title">
            <i class="bi bi-robot"></i>
            <h3>AI Result Summary</h3>
        </div>

        <div class="assessment-content ai-summary">
            @Model.AiresultSummary
        </div>

    </div>


    <div class="form-actions">

        <a asp-action="Edit"
           asp-route-id="@Model.AssessmentId"
           class="btn-primary">
            <i class="bi bi-pencil"></i>
            Edit Assessment
        </a>

        <a asp-action="Index"
           class="btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Back to List
        </a>

    </div>

</div>